NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://admin:password@localhost:27017/utab?authSource=admin
SESSION_SECRET=your-super-secret-session-key-min-32-chars
# If you call API directly from another device/browser origin, include that origin too.
# Example: CORS_ORIGIN=http://localhost:8080,http://192.168.0.10:8080
CORS_ORIGIN=http://localhost:8080

# Logging (optional)
# UTAB_LOG_LEVEL=debug
# UTAB_LOG_FILE=.codex/logs/server.log

# Rate limit identity (optional)
# RATE_LIMIT_ID_COOKIE_NAME=utab_rlid
# RATE_LIMIT_ID_COOKIE_MAX_AGE_MS=2592000000
# RATE_LIMIT_ID_SECRET=your-rate-limit-secret-min-16-chars
# RATE_LIMIT_API_IP_GUARD_WINDOW_MS=60000
# RATE_LIMIT_API_IP_GUARD_MAX=600

# Web
# Use relative /api in development so Vite proxy works from PC and mobile (LAN).
VITE_API_URL=/api
# Optional branding
# VITE_BRAND_NAME=UTab
# Set empty to hide brand text in UI:
# VITE_BRAND_NAME=
# Place logo.png under packages/web/public/ and set:
# VITE_BRAND_LOGO_URL=/logo.png
# VITE_ADMIN_REPORTS_UX_V3=true
